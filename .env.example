# TRACE AI Configuration
# Copy this file to .env and fill in your values.
# NEVER commit the .env file to version control.

# API key for FastAPI backend authentication.
# Generate a secure key: python -c "import secrets; print(secrets.token_urlsafe(32))"
TRACE_API_KEY=replace-with-your-secret-key

# LLM inference is handled locally by Ollama (no external API key needed).
# Start Ollama: ollama serve
# Pull models: ollama pull llama3.1 && ollama pull mistral
